cmake_minimum_required(VERSION 3.24)
get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED TRAINING_BUILD_SCRIPT_TEST_DIR)
  set(TRAINING_BUILD_SCRIPT_TEST_DIR "${source_root}/build-script-tests")
endif()
set(fixture "${TRAINING_BUILD_SCRIPT_TEST_DIR}/project with spaces")
file(MAKE_DIRECTORY "${fixture}/cmake" "${TRAINING_BUILD_SCRIPT_TEST_DIR}/caller")
configure_file("${source_root}/cmake/build.cmake" "${fixture}/cmake/build.cmake" COPYONLY)
file(WRITE "${fixture}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(build_wrapper_fixture LANGUAGES NONE)
file(WRITE "${CMAKE_BINARY_DIR}/observed.txt" "${CMAKE_BUILD_TYPE}\n${MARKER}\n${VALUE_LIST}")
add_custom_target(fixture ALL
  COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_BINARY_DIR}/built-$<CONFIG>")
if(FAIL_BUILD)
  add_custom_target(failure ALL COMMAND "${CMAKE_COMMAND}" -E false)
endif()
]=])

set(test_env "BUILD_TOOLCHAIN=native" "BUILD_DIR=output with spaces"
  "BUILD_CONFIG=" "BUILD_JOBS=1" "CMAKE_GENERATOR=Ninja")
set(test_args "")
function(run_case label success expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${test_env}
    "${CMAKE_COMMAND}" -P "${fixture}/cmake/build.cmake" -- ${test_args}
    WORKING_DIRECTORY "${TRAINING_BUILD_SCRIPT_TEST_DIR}/caller"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  set(output "${output}\n${error}")
  if(success AND NOT result STREQUAL "0")
    message(FATAL_ERROR "${label}: unexpected failure (${result})\n${output}")
  elseif(NOT success AND result STREQUAL "0")
    message(FATAL_ERROR "${label}: unexpectedly succeeded\n${output}")
  endif()
  if(NOT output MATCHES "${expected}")
    message(FATAL_ERROR "${label}: missing '${expected}'\n${output}")
  endif()
  message(STATUS "Passed: ${label}")
endfunction()

set(test_args -B "custom output" -G Ninja "-DMARKER:STRING=value with spaces"
  "-DVALUE_LIST:STRING=left\;right")
run_case("paths, arguments, and invocation from another directory" TRUE "build completed")
file(READ "${fixture}/custom output/observed.txt" observed)
if(NOT observed STREQUAL "Release\nvalue with spaces\nleft;right"
    OR NOT EXISTS "${fixture}/custom output/built-Release")
  message(FATAL_ERROR "Configure arguments or Release build were lost: '${observed}'")
endif()

set(test_args "-Bcustom output" -D CMAKE_BUILD_TYPE:STRING=Debug)
# The cached generator must take priority over a new environment default.
list(APPEND test_env "CMAKE_GENERATOR=Invalid generator")
run_case("cached generator and separated -D build configuration" TRUE "Debug build completed")
if(NOT EXISTS "${fixture}/custom output/built-Debug")
  message(FATAL_ERROR "Debug was configured but not built")
endif()

list(APPEND test_env "BUILD_TOOLCHAIN=llvm-mingw")
set(test_args -B "custom output")
run_case("switching toolchains requires a separate directory" FALSE "choose a new directory with -B")
list(APPEND test_env "BUILD_TOOLCHAIN=native")

set(test_args "")
list(APPEND test_env "BUILD_JOBS=0")
run_case("zero jobs" FALSE "BUILD_JOBS must be a positive integer")
list(APPEND test_env "BUILD_JOBS=abc")
run_case("non-numeric jobs" FALSE "BUILD_JOBS must be a positive integer")
list(APPEND test_env "BUILD_JOBS=1" "BUILD_CONFIG=Invalid")
run_case("invalid configuration" FALSE "BUILD_CONFIG must be")
list(APPEND test_env "BUILD_CONFIG=Release" "BUILD_TOOLCHAIN=Invalid")
run_case("invalid toolchain" FALSE "BUILD_TOOLCHAIN must be")
list(APPEND test_env "BUILD_TOOLCHAIN=native" "CMAKE_GENERATOR=Ninja")
set(test_args -B)
run_case("missing option value" FALSE "Missing value")
set(test_args -B .)
run_case("in-source build" FALSE "outside the source root")
set(test_args --preset windows-x64)
run_case("conflicting configure preset" FALSE "Unsupported build wrapper option")
set(test_args -B "configure failure" -G "Invalid generator")
run_case("configure failure stops the build" FALSE "Configure failed")
set(test_args -B "build failure" -DFAIL_BUILD=ON)
run_case("build failure is reported" FALSE "Build failed")
# Help must be usable even when the toolchain/build environment is invalid.
list(APPEND test_env "BUILD_TOOLCHAIN=Invalid" "BUILD_JOBS=0")
set(test_args --help)
run_case("help without dependencies" TRUE "Usage:")
