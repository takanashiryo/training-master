cmake_minimum_required(VERSION 3.24)

# Shared entry point for build.bat and build.sh; no Python/PowerShell dependency.
get_filename_component(project_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(build_dir "$ENV{BUILD_DIR}")
set(config "$ENV{BUILD_CONFIG}")
set(jobs "$ENV{BUILD_JOBS}")
set(toolchain "$ENV{BUILD_TOOLCHAIN}")
set(generator "")
set(platform "")
set(configure_args "")
set(pending "")
set(read_args FALSE)
math(EXPR last_arg "${CMAKE_ARGC} - 1")
foreach(index RANGE 0 ${last_arg})
  set(arg "${CMAKE_ARGV${index}}")
  if(NOT read_args)
    if(arg STREQUAL "--")
      set(read_args TRUE)
    endif()
    continue()
  endif()
  if(pending STREQUAL "cache_definition")
    set(arg "-D${arg}")
    set(pending "")
  endif()
  if(pending)
    set(${pending} "${arg}")
    set(pending "")
  elseif(arg STREQUAL "--help" OR arg STREQUAL "-h")
    message("Usage: build.bat [CMake configure options]\n       bash build.sh [CMake configure options]\n\nEnvironment:\n  BUILD_TOOLCHAIN  auto (default), native, or llvm-mingw\n  LLVM_MINGW_ROOT  LLVM MinGW installation directory (or put its bin on PATH)\n  BUILD_DIR        Build directory; -B also overrides it\n  BUILD_CONFIG     Release (default), Debug, RelWithDebInfo, or MinSizeRel\n  BUILD_JOBS       Positive parallel job count (default: at most 2)\n\nWindows defaults to native Visual Studio; other hosts cross-compile with LLVM\nMinGW and Ninja. All hosts produce Windows x64 binaries. -G and -A are accepted.\nRelative build paths are resolved against the repository, regardless of cwd.\nUse a separate build directory for each toolchain/generator.")
    return()
  elseif(arg STREQUAL "-B")
    set(pending build_dir)
  elseif(arg MATCHES "^-B(.+)$")
    set(build_dir "${CMAKE_MATCH_1}")
  elseif(arg STREQUAL "-G")
    set(pending generator)
  elseif(arg MATCHES "^-G(.+)$")
    set(generator "${CMAKE_MATCH_1}")
  elseif(arg STREQUAL "-A")
    set(pending platform)
  elseif(arg MATCHES "^-A(.+)$")
    set(platform "${CMAKE_MATCH_1}")
  elseif(arg STREQUAL "-D")
    set(pending cache_definition)
  elseif(arg MATCHES "^(-S|-P|--preset|--build|--install|--workflow|--toolchain)")
    message(FATAL_ERROR "Unsupported build wrapper option: ${arg}. Use BUILD_TOOLCHAIN and -B; pass other configure options directly to CMake.")
  else()
    if(arg MATCHES "^-DCMAKE_BUILD_TYPE(:[^=]+)?=(.*)$")
      set(config "${CMAKE_MATCH_2}")
    endif()
    # Keep cache values containing semicolons as a single subprocess argument.
    string(REPLACE ";" "\\;" arg "${arg}")
    list(APPEND configure_args "${arg}")
  endif()
endforeach()
if(pending)
  message(FATAL_ERROR "Missing value for ${pending}")
endif()

if(config STREQUAL "")
  set(config Release)
endif()
if(NOT config MATCHES "^(Release|Debug|RelWithDebInfo|MinSizeRel)$")
  message(FATAL_ERROR "BUILD_CONFIG must be Release, Debug, RelWithDebInfo, or MinSizeRel")
endif()
if(jobs STREQUAL "")
  cmake_host_system_information(RESULT jobs QUERY NUMBER_OF_LOGICAL_CORES)
  if(jobs GREATER 2 OR jobs LESS 1)
    set(jobs 2)
  endif()
endif()
if(NOT jobs MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "BUILD_JOBS must be a positive integer")
endif()
if(toolchain STREQUAL "" OR toolchain STREQUAL "auto")
  if(CMAKE_HOST_WIN32)
    set(toolchain native)
  else()
    set(toolchain llvm-mingw)
  endif()
endif()
if(NOT toolchain MATCHES "^(native|llvm-mingw)$")
  message(FATAL_ERROR "BUILD_TOOLCHAIN must be auto, native, or llvm-mingw")
endif()
if(NOT build_dir)
  if(toolchain STREQUAL "native")
    set(build_dir build)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(build_dir build-linux-cross)
  elseif(CMAKE_HOST_APPLE)
    set(build_dir build-macos-cross)
  else()
    set(build_dir build-llvm-mingw)
  endif()
endif()
get_filename_component(build_dir "${build_dir}" ABSOLUTE BASE_DIR "${project_root}")
if(build_dir STREQUAL project_root)
  message(FATAL_ERROR "Choose a build directory outside the source root")
endif()

find_program(git NAMES git REQUIRED)
set(cached_generator "")
if(EXISTS "${build_dir}/CMakeCache.txt")
  file(STRINGS "${build_dir}/CMakeCache.txt" cached_generator REGEX "^CMAKE_GENERATOR:INTERNAL=")
  string(REGEX REPLACE "^CMAKE_GENERATOR:INTERNAL=" "" cached_generator "${cached_generator}")
  if(EXISTS "${build_dir}/.training-build-toolchain")
    file(READ "${build_dir}/.training-build-toolchain" cached_toolchain)
    if(NOT cached_toolchain STREQUAL toolchain)
      message(FATAL_ERROR "This build directory uses ${cached_toolchain}; choose a new directory with -B for ${toolchain}.")
    endif()
  endif()
endif()
if(NOT generator)
  if(cached_generator)
    set(generator "${cached_generator}")
  elseif(NOT "$ENV{CMAKE_GENERATOR}" STREQUAL "")
    set(generator "$ENV{CMAKE_GENERATOR}")
  elseif(toolchain STREQUAL "llvm-mingw")
    set(generator Ninja)
  endif()
endif()

set(command "${CMAKE_COMMAND}" -S "${project_root}" -B "${build_dir}"
  "-DCMAKE_BUILD_TYPE=${config}" -DCMAKE_POLICY_VERSION_MINIMUM=3.5)
if(toolchain STREQUAL "llvm-mingw")
  # Check before configuring, rather than failing partway through compiler detection.
  foreach(tool clang clang++ windres)
    find_program(llvm_${tool} NAMES "x86_64-w64-mingw32-${tool}"
      HINTS "$ENV{LLVM_MINGW_ROOT}/bin")
    if(NOT llvm_${tool})
      message(FATAL_ERROR "Required tool not found: x86_64-w64-mingw32-${tool}. Install LLVM MinGW and set LLVM_MINGW_ROOT or add its bin directory to PATH.")
    endif()
  endforeach()
  list(APPEND command "-DCMAKE_TOOLCHAIN_FILE=${project_root}/cmake/toolchains/llvm-mingw-x64.cmake")
endif()
if(generator)
  list(APPEND command -G "${generator}")
endif()
if(generator MATCHES "^Ninja")
  find_program(ninja NAMES ninja ninja-build REQUIRED)
endif()
if(NOT platform AND toolchain STREQUAL "native" AND CMAKE_HOST_WIN32
    AND (NOT generator OR generator MATCHES "^Visual Studio "))
  set(platform x64)
endif()
if(platform)
  list(APPEND command -A "${platform}")
endif()
list(APPEND command "${configure_args}")

message(STATUS "Host: ${CMAKE_HOST_SYSTEM_NAME}; toolchain: ${toolchain}; configuration: ${config}; jobs: ${jobs}")
message(STATUS "Build directory: ${build_dir}")
execute_process(COMMAND ${command} WORKING_DIRECTORY "${project_root}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Configure failed (${result}). When changing toolchains or generators, choose a new directory with -B.")
endif()
file(WRITE "${build_dir}/.training-build-toolchain" "${toolchain}")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build_dir}" --config "${config}" --parallel "${jobs}"
  WORKING_DIRECTORY "${project_root}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Build failed (${result})")
endif()
message(STATUS "Windows x64 ${config} build completed: ${build_dir}")
